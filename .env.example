# =======================================================
# ShopPOS Multi-Tenant SaaS - Production Environment Configuration
# =======================================================

# Server Port (Render sets this dynamically via $PORT, defaults to 3000)
PORT=3000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shoppos?retryWrites=true&w=majority
MONGODB_URI= MONGODB_URL=mongodb+srv://mdsaad1289:CxhvPcMnaJFLhBM6@cluster0.20jynkx.mongodb.net/posbd

# JWT Secret Key
# CRITICAL: Must be identical between Admin.pos and Owner Web App for shared authentication
JWT_SECRET=shoppos_production_jwt_secret_key_884920

# Allowed CORS Origins
# Comma-separated list of origins allowed to interact with the API with credentials.
# In development or when using wildcard (*), dynamic origin reflection allows credentials: true.
# Example: https://admin-pos.onrender.com,https://shoppos-owner.onrender.com,http://localhost:5173
ALLOWED_ORIGINS=*

# Render Deployment Environment Helpers
# Render automatically provides RENDER_EXTERNAL_URL on deployed web services
# Example: https://shoppos-owner.onrender.com
RENDER_EXTERNAL_URL=https://shoppos-owner.onrender.com

# Admin Portal URL (for cross-service redirects and management links)
ADMIN_APP_URL=https://admin-pos.onrender.com

